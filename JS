// AI proxy so the Anthropic API key stays on the server, never in the web page.
// App settings: ANTHROPIC_API_KEY, ALLOWED_ORIGIN (e.g. https://yourname.github.io)
const { app } = require("@azure/functions");
app.http("ai", { methods: ["POST"], authLevel: "anonymous", route: "ai", handler: async (req) => {
  const origin = req.headers.get("origin") || "";
  if (process.env.ALLOWED_ORIGIN && origin !== process.env.ALLOWED_ORIGIN) return { status: 403, jsonBody: { error: "Forbidden" } };
  const { prompt } = await req.json();
  if (!prompt || String(prompt).length > 20000) return { status: 400, jsonBody: { error: "Bad prompt" } };
  const r = await fetch("https://api.anthropic.com/v1/messages", {
    method: "POST",
    headers: { "content-type": "application/json", "x-api-key": process.env.ANTHROPIC_API_KEY, "anthropic-version": "2023-06-01" },
    body: JSON.stringify({ model: "claude-sonnet-5-5", max_tokens: 3000, messages: [{ role: "user", content: String(prompt) }] }),
  });
  if (!r.ok) return { status: 502, jsonBody: { error: "Upstream error" } };
  const d = await r.json();
  return { jsonBody: { text: (d.content || []).map((c) => c.text || "").join("") } };
}});
